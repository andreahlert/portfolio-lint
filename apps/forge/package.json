{
  "name": "portfolio-lint-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Jira Cloud app (Atlassian Forge) for the Portfolio AI-Readiness Framework.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "forge lint",
    "deploy": "forge deploy",
    "install:site": "forge install",
    "validate:manifest": "node validate-manifest.mjs"
  },
  "dependencies": {
    "@forge/api": "^5.0.0",
    "@forge/bridge": "^5.0.0",
    "@forge/events": "^3.0.4",
    "@forge/react": "^11.0.0",
    "@forge/resolver": "^1.6.0",
    "@portfolio-lint/core": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@forge/cli": "^13.4.0",
    "@types/react": "^18.2.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
