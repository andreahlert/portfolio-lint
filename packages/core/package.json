{
  "name": "@portfolio-lint/core",
  "version": "0.1.0",
  "description": "Rules engine and scorer for the Portfolio AI-Readiness Framework. Pure functions, no IO.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
